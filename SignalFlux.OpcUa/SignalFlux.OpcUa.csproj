<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>SignalFlux.OpcUa</Title>
    <Description>OPC UA client adapter for SignalFlux — connect, read, write, subscribe, and browse OPC UA servers with Signal&lt;T&gt; and Measurement&lt;T&gt; types.</Description>
    <PackageId>SignalFlux.OpcUa</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>SignalFlux;Protocols;OPC;OPCUA;Industrial;SCADA;Engineering;dotnet-library</PackageTags>
    <PackageReleaseNotes>Adds write support (WriteNodeAsync, WriteNodesAsync), username/password authentication with automatic application certificate creation, automatic reconnection with State property and OnStateChanged events, and engineering-unit resolution to typed UnitsNet units via ReadNodeWithUnitAsync.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/signalflux</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/signalflux.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignalFlux\SignalFlux.csproj" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.378.*" />
  </ItemGroup>

</Project>
