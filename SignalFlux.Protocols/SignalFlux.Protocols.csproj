<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>SignalFlux.Protocols</Title>
    <Description>SignalFlux.Protocol provides protocol adapters for Modbus, MAVLink, NMEA 0183, CAN bus (DBC), and ARINC 429, bridging Signal&lt;T&gt; and Measurement&lt;T&gt; with real-world protocol data.</Description>
    <PackageId>SignalFlux.Protocols</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>SignalFlux;Protocols;Modbus;MAVLink;NMEA0183;CAN;DBC;ARINC429;Industrial;Avionics;Engineering;dotnet-library</PackageTags>
    <PackageReleaseNotes>
      - CAN bus: frame model and transport abstraction (`ICanTransport`) with in-memory/loopback transport
      - CAN bus: Intel/Motorola bit-layout signal encode/decode to `Signal` and `Measurement`
      - CAN bus: DBC file parser and signal decoder with multiplexing, scaling, and range-based quality
      - CAN bus: SocketCAN, PCAN, and Kvaser platform transport stubs
      - ARINC 429: 32-bit word encode/decode with BNR scaling and parity handling
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/signalflux</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/signalflux.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignalFlux\SignalFlux.csproj" />
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="MavLinkSharp" Version="1.11.0" />
    <PackageReference Include="SharpGIS.NmeaParser" Version="3.0.0" />
  </ItemGroup>

</Project>
